{
  "name": "tauri-hasgard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "protocol:sync": "bun scripts/sync-protocol.mjs",
    "protocol:check": "bun scripts/sync-protocol.mjs --check",
    "build": "bun run --filter '@nyssance/tauri-hasgard' build",
    "format": "cargo fmt && bun run format:web",
    "format:check": "cargo fmt -- --check && bun run format:check:web",
    "format:check:web": "bun fmt --check",
    "format:web": "bun fmt",
    "test": "bun run --filter '@nyssance/tauri-hasgard' test",
    "typecheck": "bun run --filter '@nyssance/tauri-hasgard' typecheck && bun run --cwd examples/fixture-app typecheck",
    "test:e2e": "bun run --cwd examples/fixture-app test:e2e",
    "test:e2e:stress": "bun run --cwd examples/fixture-app test:e2e:stress",
    "ts7-lint": "ts7-lint"
  },
  "packageManager": "bun@latest",
  "devDependencies": {
    "@nyssance/ts7-lint": "^0.1.3"
  }
}
